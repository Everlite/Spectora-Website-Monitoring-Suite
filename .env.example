APP_NAME=Spectora
APP_ENV=production
APP_KEY=base64:PLACEHOLDER
APP_DEBUG=false
APP_URL=http://localhost

# Force HTTPS server vars when TLS terminates at a proxy without X-Forwarded-Proto.
# Normally inferred automatically when APP_URL starts with https://
# SPECTORA_FORCE_HTTPS=false

# Trusted reverse proxies: comma-separated IPs, or * behind Nginx Proxy Manager / Traefik.
# Leave empty for local development without a proxy.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Spectora is locked to SQLite for zero-config deployment.
# We store the DB in storage/ to avoid volume-masking the 
# database/migrations directory in Docker.
DB_DATABASE=/var/www/html/storage/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# VAPID Keys for Push Notifications
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Agency Specific Settings
VITE_APP_NAME="${APP_NAME}"

# Security & Registration
# Set to false to disable public user registration in production.
# Initial admin users can be created using database seeders or CLI when registration is closed.
SPECTORA_REGISTRATION_ENABLED=false
